        <mxCell id="vm-host-os" value="Host Operating System" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="280" width="200" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="vm-hypervisor" value="Hypervisor (VMware, VirtualBox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="200" height="30" as="geometry" />
        </mxCell>
        
        <!-- VM Instances -->
        <mxCell id="vm1" value="VM 1&#xa;Guest OS&#xa;App A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="60" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="vm2" value="VM 2&#xa;Guest OS&#xa;App B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="160" width="60" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="vm3" value="VM 3&#xa;Guest OS&#xa;App C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="160" width="60" height="70" as="geometry" />
