            <mxPoint x="380" y="200" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Key Differences -->
        <mxCell id="vm-pros" value="VMs:&#xa;✓ Complete isolation&#xa;✓ Different OS support&#xa;✗ Resource heavy&#xa;✗ Slower startup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="150" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="container-pros" value="Containers:&#xa;✓ Lightweight&#xa;✓ Fast startup&#xa;✓ Efficient resources&#xa;✗ Shared OS kernel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="150" height="80" as="geometry" />
