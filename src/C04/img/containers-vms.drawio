        <mxCell id="container2" value="Container 2&#xa;App B&#xa;Dependencies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
