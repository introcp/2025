        <!-- VM Stack -->
        <mxCell id="vm-hardware" value="Physical Hardware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
